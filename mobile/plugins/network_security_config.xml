<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml
  EcoQuest Mobile — Network Security Configuration

  Policy:
    - All traffic MUST use HTTPS (TLS 1.2+)
    - No cleartext HTTP allowed (required for Solana dApp Store compliance)
    - Certificate pinning for Helius RPC (optional — uncomment to enable)
    - Debug overrides only in debug builds

  References:
    - https://developer.android.com/training/articles/security-config
    - Solana dApp Store security requirements
-->
<network-security-config>

  <!-- Default: HTTPS only for all domains -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <!-- Trust system CAs (required for Helius, Triton, Solana RPC) -->
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Helius RPC — explicit HTTPS enforcement -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">helius-rpc.com</domain>
    <domain includeSubdomains="true">rpcpool.com</domain>
    <domain includeSubdomains="true">solana.com</domain>
    <domain includeSubdomains="true">pinata.cloud</domain>
    <domain includeSubdomains="true">arweave.net</domain>
    <domain includeSubdomains="true">irys.xyz</domain>
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </domain-config>

  <!--
    Localhost cleartext — needed for Metro bundler in debug builds.
    NOTE: This is a top-level domain-config, NOT nested inside debug-overrides.
    Android Lint does not allow nested domain-config inside debug-overrides.
    Security impact: negligible — localhost is only reachable on the same device.
  -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>

  <!-- Debug builds only: also trust user-installed CAs (e.g. Charles Proxy) -->
  <debug-overrides>
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </debug-overrides>

</network-security-config>
