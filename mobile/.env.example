# ─────────────────────────────────────────────────────────────────────────────
# EcoQuest Mobile — Environment Variables
# Copy file ini ke mobile/.env dan isi sesuai kebutuhan
# ─────────────────────────────────────────────────────────────────────────────

# ── Solana Cluster ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SOLANA_CLUSTER=devnet

# ── Program ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_PROGRAM_ID=4RoEXMwC3pvm1NYb8oXvcezJzsvxZmCwMgNUKZxCnju5

# ── SKR Token Mint (devnet) ────────────────────────────────────────────────────
# Buat dengan: yarn devnet:mint-skr
EXPO_PUBLIC_SKR_MINT=

# ── RPC & WebSocket ────────────────────────────────────────────────────────────
# Helius devnet (gratis di helius.dev) — lebih cepat dari public devnet
EXPO_PUBLIC_HELIUS_API_KEY=

# Triton (opsional, fallback)
EXPO_PUBLIC_TRITON_API_KEY=

# ── Admin ──────────────────────────────────────────────────────────────────────
# Wallet address yang boleh akses Admin Dashboard
# Harus sama dengan wallet ~/.config/solana/id.json yang menjalankan init-devnet.ts
EXPO_PUBLIC_ADMIN_WALLET=

# ── ECO Token Mint (devnet) ────────────────────────────────────────────────────
# Buat dengan SPL token-create, paste pubkey mint address di sini
EXPO_PUBLIC_ECO_MINT=

# ── Gasless Relayer ────────────────────────────────────────────────────────────
# ⚠️  DEVNET ONLY — relayer auto-generate keypair + requestAirdrop di devnet.
# Tidak butuh RELAYER_PRIVATE_KEY. Untuk production, ganti dengan backend KMS.
# EXPO_PUBLIC_RELAYER_PUBLIC_KEY=  (opsional, hanya untuk display di UI)
